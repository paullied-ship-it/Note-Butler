# Copy this file to ".env" and fill in the values.

# --- Database -------------------------------------------------------------
# RECOMMENDED (always-on capture): a free Neon Postgres connection string.
#   https://neon.tech -> it looks like:
#   postgresql://user:pass@ep-xxxx.aws.neon.tech/neondb?sslmode=require
# Leave blank to use a local SQLite file (notes.db) for PC-on-only use.
DATABASE_URL=

# --- Telegram bot ---------------------------------------------------------
# From @BotFather when you create your bot (looks like 123456:ABC-DEF...).
TELEGRAM_BOT_TOKEN=

# Optional: lock the bot to your chat only. Message the bot /start once to
# learn your chat ID, then paste it here so no one else's messages are saved.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional (webhook mode): any long random string you pick. Telegram echoes it
# back in a header so the bot can reject forged requests.
TELEGRAM_WEBHOOK_SECRET=

# --- Streamlit UI ---------------------------------------------------------
# Optional: if set, the UI asks for this password (use it if you host the UI).
APP_PASSWORD=
# Timezone used to display note times.
APP_TIMEZONE=America/New_York
